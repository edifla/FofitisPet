# Copie para .env. Os valores batem com o Postgres do compose.yaml (só para desenvolvimento).
DATABASE_URL="postgresql://fofitis:fofitis@localhost:5432/fofitispet?schema=public"

# Segredo do Auth.js para assinar a sessão. Gere um com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Fora da Vercel, o Auth.js só aceita requisições de um endereço conhecido. Em produção, defina
# AUTH_URL com o endereço do site (ex.: https://fofitispet.com.br). Em desenvolvimento não precisa.
# AUTH_URL="https://fofitispet.com.br"

# Endereço público do site, usado nos links enviados por e-mail.
APP_URL="http://localhost:3000"

# Pasta dos arquivos enviados (imagens). Padrão: ./storage
# STORAGE_DIR="storage"

# Gateway de pagamento (KAN-26). Padrão: "simulado", que não cobra nada e mostra um botão para
# simular o aviso do banco. Em produção o simulado fica desligado, a não ser que
# ALLOW_SIMULATED_PAYMENTS=true (ex.: um ambiente de demonstração). Mercado Pago entra na KAN-55.
# PAYMENT_PROVIDER="simulado"
# ALLOW_SIMULATED_PAYMENTS="false"

# Segredo que assina os avisos do gateway em /api/pagamentos/webhook (KAN-110). Sem ele o webhook
# responde 503. Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PAYMENT_WEBHOOK_SECRET="troque-por-um-segredo-aleatorio"
# Protege a rotina /api/pedidos/expirar, que cancela pedidos não pagos fora do prazo. O agendador
# chama com "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET="troque-por-um-segredo-aleatorio"
