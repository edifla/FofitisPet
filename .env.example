# Copie para .env. Os valores batem com o Postgres do compose.yaml (só para desenvolvimento).
DATABASE_URL="postgresql://fofitis:fofitis@localhost:5432/fofitispet?schema=public"

# Segredo do Auth.js para assinar a sessão. Gere um com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Fora da Vercel, o Auth.js só aceita requisições de um endereço conhecido. Em produção, defina
# AUTH_URL com o endereço do site (ex.: https://fofitispet.com.br). Em desenvolvimento não precisa.
# AUTH_URL="https://fofitispet.com.br"

# Endereço público do site, usado nos links enviados por e-mail.
APP_URL="http://localhost:3000"

# Pasta dos arquivos enviados (imagens). Padrão: ./storage
# STORAGE_DIR="storage"
