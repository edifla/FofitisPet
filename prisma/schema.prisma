// Schema do FofitisPet.
// Docs: https://pris.ly/d/prisma-schema
// Valores em dinheiro são guardados em centavos (Int) para evitar erro de arredondamento.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuários e endereços (KAN-85)
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  // Sempre gravado em minúsculas pela aplicação, para o @unique valer sem diferenciar caixa.
  email         String    @unique
  // Nulo enquanto a conta não tiver senha (ex.: login social na KAN-20).
  passwordHash  String?
  emailVerified DateTime?
  phone         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses      Address[]
  stockMovements StockMovement[]
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  // Apelido escolhido pelo cliente, ex.: "Casa", "Trabalho".
  label         String?
  recipientName String
  zipCode       String   @db.VarChar(8)
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String   @db.Char(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Produtos, categorias e estoque Loja/Abrigo (KAN-86)
// ---------------------------------------------------------------------------

// Espécies atendidas por um produto. Também usada no cadastro de animais.
enum Species {
  DOG
  CAT
  BIRD
  FISH
  SMALL_PET
  OTHER
}

// Onde o estoque está: na loja (à venda) ou no abrigo (doado).
enum StockLocation {
  STORE
  SHELTER
}

enum StockMovementType {
  // Entrada de mercadoria na loja.
  RESTOCK
  // Correção manual de saldo (inventário, avaria).
  ADJUSTMENT
  // Venda para um cliente (sai da loja).
  SALE
  // Compra para o abrigo: sai da loja e entra no abrigo.
  DONATION_TRANSFER
  // Item dado aos animais (sai do abrigo).
  SHELTER_CONSUMPTION
  // Devolução de uma venda cancelada.
  RETURN
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  // Categoria pai, para subcategorias (ex.: Alimentação > Ração seca).
  parentId    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String
  categoryId       String
  brandId          String?
  species          Species[]
  // Pode ser comprado para o abrigo (KAN-29).
  donationEligible Boolean   @default(false)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Variação vendável de um produto (tamanho, sabor, peso). Todo produto tem ao menos uma.
model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique
  // Nome exibido, ex.: "15 kg", "Frango".
  name        String
  priceCents  Int
  // Peso de uma unidade, usado no frete e nas metas de campanha em kg (KAN-42).
  weightGrams Int?
  // Atributos livres da variação, ex.: { "sabor": "frango", "tamanho": "15 kg" }.
  attributes  Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@index([productId])
}

// Saldo atual de uma variação em cada local. Mantido junto com StockMovement na mesma transação.
model StockLevel {
  variantId String
  location  StockLocation
  quantity  Int           @default(0)
  updatedAt DateTime      @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, location])
}

// Histórico de toda entrada e saída de estoque. O saldo em StockLevel é a soma destes registros.
model StockMovement {
  id           String            @id @default(cuid())
  variantId    String
  type         StockMovementType
  // Nulo quando a unidade entra de fora (RESTOCK) ou sai do sistema (SALE, SHELTER_CONSUMPTION).
  fromLocation StockLocation?
  toLocation   StockLocation?
  quantity     Int
  note         String?
  createdById  String?
  createdAt    DateTime          @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}
