// Schema do FofitisPet.
// Docs: https://pris.ly/d/prisma-schema
// Valores em dinheiro são guardados em centavos (Int) para evitar erro de arredondamento.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuários e endereços (KAN-85)
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String
  // Sempre gravado em minúsculas pela aplicação, para o @unique valer sem diferenciar caixa.
  email          String    @unique
  // Nulo enquanto a conta não tiver senha (ex.: login social na KAN-20).
  passwordHash   String?
  emailVerified  DateTime?
  phone          String?
  role           Role      @default(CUSTOMER)
  // Incrementado ao trocar a senha: sessões emitidas com a versão antiga deixam de valer.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses           Address[]
  stockMovements      StockMovement[]
  orders              Order[]
  adoptionRequests    AdoptionRequest[]
  shelterConsumptions ShelterConsumption[]
  adoptionEvents      AdoptionRequestEvent[]
  passwordResetTokens PasswordResetToken[]
  cart                Cart?
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  // Apelido escolhido pelo cliente, ex.: "Casa", "Trabalho".
  label         String?
  recipientName String
  zipCode       String   @db.VarChar(8)
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String   @db.Char(2)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Produtos, categorias e estoque Loja/Abrigo (KAN-86)
// ---------------------------------------------------------------------------

// Espécies atendidas por um produto. Também usada no cadastro de animais.
enum Species {
  DOG
  CAT
  BIRD
  FISH
  SMALL_PET
  OTHER
}

// Onde o estoque está: na loja (à venda) ou no abrigo (doado).
enum StockLocation {
  STORE
  SHELTER
}

enum StockMovementType {
  // Entrada de mercadoria na loja.
  RESTOCK
  // Correção manual de saldo (inventário, avaria).
  ADJUSTMENT
  // Venda para um cliente (sai da loja).
  SALE
  // Compra para o abrigo: sai da loja e entra no abrigo.
  DONATION_TRANSFER
  // Item dado aos animais (sai do abrigo).
  SHELTER_CONSUMPTION
  // Devolução de uma venda cancelada.
  RETURN
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  // Categoria pai, para subcategorias (ex.: Alimentação > Ração seca).
  parentId    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String
  categoryId       String
  brandId          String?
  species          Species[]
  // Pode ser comprado para o abrigo (KAN-29).
  donationEligible Boolean   @default(false)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  // Chave no armazenamento (lib/storage); a url é o endereço público dela.
  storageKey String   @unique
  url        String
  alt        String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Variação vendável de um produto (tamanho, sabor, peso). Todo produto tem ao menos uma.
model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique
  // Nome exibido, ex.: "15 kg", "Frango".
  name        String
  priceCents  Int
  // Peso de uma unidade, usado no frete e nas metas de campanha em kg (KAN-42).
  weightGrams Int?
  // Atributos livres da variação, ex.: { "sabor": "frango", "tamanho": "15 kg" }.
  attributes  Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  orderItems          OrderItem[]
  shelterConsumptions ShelterConsumption[]
  cartItems           CartItem[]
  donationKitItems    DonationKitItem[]

  @@index([productId])
}

// Saldo atual de uma variação em cada local. Mantido junto com StockMovement na mesma transação.
model StockLevel {
  variantId      String
  location       StockLocation
  quantity       Int           @default(0)
  // Saldo desejado no abrigo. Itens abaixo da meta aparecem em "Itens mais necessários" (KAN-33).
  targetQuantity Int?
  updatedAt      DateTime      @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, location])
}

// Histórico de toda entrada e saída de estoque. O saldo em StockLevel é a soma destes registros.
model StockMovement {
  id           String            @id @default(cuid())
  variantId    String
  type         StockMovementType
  // Nulo quando a unidade entra de fora (RESTOCK) ou sai do sistema (SALE, SHELTER_CONSUMPTION).
  fromLocation StockLocation?
  toLocation   StockLocation?
  quantity     Int
  note         String?
  // Pedido que gerou o movimento (SALE, DONATION_TRANSFER, RETURN).
  orderId      String?
  createdById  String?
  createdAt    DateTime          @default(now())

  variant            ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shelterConsumption ShelterConsumption?

  @@index([variantId, createdAt])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Pedidos, itens e pagamentos (KAN-87)
// ---------------------------------------------------------------------------

// Para quem vai o pedido. Itens marcados como "Doar este item" geram um pedido SHELTER separado,
// sem frete e sem endereço (KAN-30, KAN-31).
enum OrderDestination {
  CUSTOMER
  SHELTER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  // Pedidos SHELTER vão direto de PAID para DELIVERED com a transferência de estoque (KAN-32).
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
}

model Order {
  id            String           @id @default(cuid())
  // Número sequencial mostrado ao cliente e nos e-mails.
  number        Int              @unique @default(autoincrement())
  userId        String
  destination   OrderDestination @default(CUSTOMER)
  status        OrderStatus      @default(PENDING_PAYMENT)
  // Doação sem o nome do cliente na página de transparência (KAN-31).
  anonymous     Boolean          @default(false)
  subtotalCents Int
  shippingCents Int              @default(0)
  discountCents Int              @default(0)
  totalCents    Int

  // Cópia do endereço no momento da compra. Nula em pedidos SHELTER.
  shippingRecipientName String?
  shippingZipCode       String? @db.VarChar(8)
  shippingStreet        String?
  shippingNumber        String?
  shippingComplement    String?
  shippingNeighborhood  String?
  shippingCity          String?
  shippingState         String? @db.Char(2)
  shippingMethod        String?
  trackingCode          String?

  paidAt       DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  canceledAt   DateTime?
  // Motivo mostrado ao cliente, ex.: "Prazo de pagamento expirado".
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  variantId      String
  // Cópia do nome e do preço no momento da compra, para o histórico não mudar se o produto mudar.
  productName    String
  variantName    String
  unitPriceCents Int
  quantity       Int
  totalCents     Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  // Gateway usado: "simulado" por enquanto; "mercadopago" a partir da KAN-55.
  provider          String
  // Id do pagamento no gateway, usado para casar os webhooks.
  providerPaymentId String?
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  // Motivo informado pelo gateway, ex.: "saldo insuficiente" numa recusa.
  statusDetail      String?
  amountCents       Int
  pixQrCode         String?
  pixExpiresAt      DateTime?
  // Cartão: só bandeira, 4 últimos dígitos e parcelas. O número do cartão nunca é guardado.
  cardBrand         String?
  cardLastFour      String?
  installments      Int?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

// Webhook recebido do gateway. O @@unique evita processar o mesmo evento duas vezes.
model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  paymentId   String?
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Animais e solicitações de adoção (KAN-88)
// ---------------------------------------------------------------------------

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
}

enum AnimalSex {
  MALE
  FEMALE
}

enum AnimalStatus {
  AVAILABLE
  // Com uma solicitação aprovada, aguardando a entrega ao adotante.
  RESERVED
  ADOPTED
  // Em tratamento ou fora da listagem por outro motivo.
  UNAVAILABLE
}

enum Temperament {
  CALM
  PLAYFUL
  ENERGETIC
  SHY
  AFFECTIONATE
  INDEPENDENT
  GOOD_WITH_KIDS
  GOOD_WITH_DOGS
  GOOD_WITH_CATS
}

enum HousingType {
  HOUSE
  APARTMENT
  FARM
  OTHER
}

// Fluxo de status da KAN-40.
enum AdoptionRequestStatus {
  RECEIVED
  IN_REVIEW
  INTERVIEW
  APPROVED
  REJECTED
  // Cancelada pelo próprio interessado.
  WITHDRAWN
}

model Animal {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  species      Species
  size         AnimalSize
  sex          AnimalSex
  // Data de nascimento, muitas vezes estimada no resgate. A idade exibida é calculada a partir dela.
  birthDate    DateTime?     @db.Date
  temperament  Temperament[]
  story        String
  healthNotes  String?
  neutered     Boolean       @default(false)
  dewormed     Boolean       @default(false)
  specialNeeds String?
  status       AnimalStatus  @default(AVAILABLE)
  arrivedAt    DateTime?     @db.Date
  adoptedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  images              AnimalImage[]
  vaccinations        Vaccination[]
  adoptionRequests    AdoptionRequest[]
  shelterConsumptions ShelterConsumption[]

  @@index([status, species])
}

model AnimalImage {
  id         String   @id @default(cuid())
  animalId   String
  // Chave no armazenamento (lib/storage), como em ProductImage (KAN-112).
  storageKey String   @unique
  url        String
  alt        String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
}

model Vaccination {
  id         String    @id @default(cuid())
  animalId   String
  // Nome da vacina, ex.: "V10", "Antirrábica".
  name       String
  appliedAt  DateTime  @db.Date
  nextDoseAt DateTime? @db.Date
  createdAt  DateTime  @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
}

// Formulário de interesse (KAN-39). Os dados do interessado ficam copiados aqui porque
// o termo de adoção (KAN-41) precisa deles mesmo que o cadastro do usuário mude.
model AdoptionRequest {
  id       String                @id @default(cuid())
  animalId String
  // Nulo se o formulário for enviado sem login.
  userId   String?
  status   AdoptionRequestStatus @default(RECEIVED)

  applicantName  String
  applicantEmail String
  applicantPhone String
  applicantCity  String
  applicantState String @db.Char(2)

  housingType          HousingType
  ownsHome             Boolean
  hasYard              Boolean
  // Todos na casa concordam com a adoção.
  householdAgrees      Boolean
  hasOtherPets         Boolean
  otherPetsDescription String?
  experience           String
  reason               String

  // Anotações internas do abrigo, nunca mostradas ao interessado.
  adminNotes  String?
  interviewAt DateTime?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  animal Animal                 @relation(fields: [animalId], references: [id], onDelete: Restrict)
  user   User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  events AdoptionRequestEvent[]

  @@index([animalId, status])
  @@index([userId])
  @@index([status, createdAt])
}

// Histórico de mudanças de status de uma solicitação (KAN-116). O primeiro evento é o
// recebimento do formulário, sem status anterior e sem autor.
model AdoptionRequestEvent {
  id          String                 @id @default(cuid())
  requestId   String
  fromStatus  AdoptionRequestStatus?
  toStatus    AdoptionRequestStatus
  note        String?
  // Nulo para eventos automáticos (formulário recebido, animal adotado por outra família).
  createdById String?
  createdAt   DateTime               @default(now())

  request   AdoptionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

// ---------------------------------------------------------------------------
// Consumo do abrigo (KAN-89)
// ---------------------------------------------------------------------------

// O que foi dado aos animais (KAN-34). Cada registro gera um StockMovement SHELTER_CONSUMPTION,
// que baixa o saldo do abrigo. animalId alimenta o selo de ração recebida (KAN-45).
model ShelterConsumption {
  id              String   @id @default(cuid())
  variantId       String
  quantity        Int
  // Nulo quando o item foi usado para vários animais ou para o abrigo em geral.
  animalId        String?
  consumedAt      DateTime @default(now())
  note            String?
  recordedById    String
  stockMovementId String   @unique
  createdAt       DateTime @default(now())

  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  animal        Animal?        @relation(fields: [animalId], references: [id], onDelete: SetNull)
  recordedBy    User           @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  stockMovement StockMovement  @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@index([variantId, consumedAt])
  @@index([animalId])
}

// ---------------------------------------------------------------------------
// Recuperação de senha (KAN-92)
// ---------------------------------------------------------------------------

// Link de uso único enviado por e-mail. Só o hash SHA-256 do token fica no banco.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Carrinho (KAN-24)
// ---------------------------------------------------------------------------

// Carrinho guardado no banco e identificado por um cookie, então funciona sem login.
// O login só é exigido no checkout; a KAN-104 liga o carrinho à conta.
model Cart {
  // UUID aleatório: é o valor do cookie, não pode ser adivinhado.
  id        String   @id @default(uuid())
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  // Comprado para o abrigo (KAN-30): vai num pedido de doação, sem frete nem endereço.
  donation  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // O mesmo produto pode estar duas vezes: uma para o cliente e outra para o abrigo.
  @@unique([cartId, variantId, donation])
}

// ---------------------------------------------------------------------------
// Campanhas de ração (KAN-42)
// ---------------------------------------------------------------------------

// Meta em kg de ração doada ao abrigo num período. O progresso é calculado a partir das doações
// entregues (pedidos SHELTER) com itens de alimentação, não é gravado.
model Campaign {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  goalGrams   Int
  // Só conta ração para esta espécie; nulo conta toda a ração.
  species     Species?
  startsAt    DateTime  @db.Date
  // Último dia da campanha, inclusive. Nulo: sem data para acabar.
  endsAt      DateTime? @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, startsAt])
}

// ---------------------------------------------------------------------------
// Kits de doação (KAN-43)
// ---------------------------------------------------------------------------

// Conjunto pronto de itens para doar ao abrigo, ex.: "1 kg de ração". O preço é a soma dos preços
// atuais das variações; ao doar, os itens entram no carrinho como doação (KAN-30).
model DonationKit {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items DonationKitItem[]

  @@index([active, position])
}

model DonationKitItem {
  id        String @id @default(cuid())
  kitId     String
  variantId String
  quantity  Int

  kit     DonationKit    @relation(fields: [kitId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([kitId, variantId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Transparência (KAN-44)
// ---------------------------------------------------------------------------

// Fotos de entregas e do dia a dia do abrigo, mostradas na página de transparência.
model TransparencyPhoto {
  id         String   @id @default(cuid())
  // Chave no armazenamento (lib/storage), como em AnimalImage.
  storageKey String   @unique
  url        String
  caption    String
  // Dia em que a foto foi tirada; ordena a galeria.
  takenOn    DateTime @db.Date
  createdAt  DateTime @default(now())

  @@index([takenOn])
}

// ---------------------------------------------------------------------------
// Limite de tentativas (KAN-122)
// ---------------------------------------------------------------------------

// Contador por janela fixa, ex.: "login:ip:1.2.3.4". Fica no banco para valer entre várias
// instâncias do servidor. Linhas vencidas são apagadas pela rotina periódica.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
